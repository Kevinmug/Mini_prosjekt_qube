<?xml version="1.0"?>
<robot name="qube">

  <link name="world"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <link name="disk_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
  </link>

  <link name="pointer_link">
    <visual>
      <origin xyz="0.015 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.005 0.005"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="motor_joint" type="revolute">
    <parent link="base_link"/>
    <child link="disk_link"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="1.0" velocity="10.0"/>
  </joint>

  <joint name="pointer_joint" type="fixed">
    <parent link="disk_link"/>
    <child link="pointer_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>