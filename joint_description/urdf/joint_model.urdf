<?xml version="1.0"?>
<robot name="joint_model">

  <link name="world"/>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.85 0.1 0.1 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.12 0.10"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="disk_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.012"/>
      </geometry>
      <material name="red"/>
    </visual>

    <visual>
      <origin xyz="0.012 0 0.007" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.004 0.002"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>